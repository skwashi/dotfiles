# EditorConfig is awesome: http://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file,
# trim trailing white space before newline
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.sh]
indent_size = 2

[*.js]
indent_size = 4

[*.ts]
indent_size = 4

[*.json]
indent_size = 2

[package.json]
indent_size = 2

[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2

[*.yml.*]
indent_size = 2

[*.yaml.*]
indent_size = 2

[lang/*]
indent_size = 2

[Makefile]
indent_style = tab

[*.mk]
indent_style = tab

[.editorconfig]
indent_size = 2
