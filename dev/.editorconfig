# EditorConfig is awesome: http://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.conf]
indent_size = 2

[*.sh]
indent_size = 2

[Makefile]
indent_size = 4
indent_style = tab

[*.mk]
indent_size = 4
indent_style = tab

[*.{js,jsx}]
indent_size = 4

[*.{ts,tsx}]
indent_size = 4

[*.json]
indent_size = 2

[package.json]
indent_size = 2

[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2

[*.yml.*]
indent_size = 2

[*.yaml.*]
indent_size = 2

[*.yaml.j2]
indent_size = 2

[*.ynl.j2]
indent_size = 2

[lang/*]
indent_size = 2


[.editorconfig]
indent_size = 2
